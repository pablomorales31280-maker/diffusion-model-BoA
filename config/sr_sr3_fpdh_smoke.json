{
    "name": "sr_boa_fpdh_smoke",
    "phase": "train",
    "gpu_ids": [
        0
    ],
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "name": "GoPro-train",
            "mode": "HR",
            "dataroot": "/hkfs/work/workspace/scratch/ma_pmorales-nafnet_try/dm_boa/dataset_lmdb/gopro_train.lmdb",
            "datatype": "lmdb",
            "l_resolution": 128,
            "r_resolution": 128,
            "batch_size": 1,
            "num_workers": 2,
            "use_shuffle": true,
            "data_len": 20
        },
        "val": {
            "name": "GoPro-test",
            "mode": "LRHR",
            "dataroot": "/hkfs/work/workspace/scratch/ma_pmorales-nafnet_try/dm_boa/dataset_lmdb/gopro_test.lmdb",
            "datatype": "lmdb",
            "l_resolution": 128,
            "r_resolution": 128,
            "data_len": 3
        }
    },
    "model": {
        "which_model_G": "sr3",
        "finetune_norm": false,
        "unet": {
            "PreNet": {
                "in_channel": 3,
                "out_channel": 3,
                "inner_channel": 64,
                "channel_multiplier": [
                    1,
                    2,
                    3,
                    4
                ],
                "attn_res": [
                    32
                ],
                "res_blocks": 3,
                "dropout": 0.1,
                "downsample_type": "convstride2",
                "upsample_type": "pixelshuffle",
                "fpdh_drop_prob": 0.3
            },
            "DenoiseNet": {
                "in_channel": 6,
                "out_channel": 3,
                "inner_channel": 32,
                "channel_multiplier": [
                    1,
                    2,
                    3,
                    4
                ],
                "attn_res": [
                    32
                ],
                "res_blocks": 3,
                "dropout": 0.1,
                "downsample_type": "fpdh",
                "upsample_type": "freqavgup",
                "fpdh_drop_prob": 0.3
            }
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 128,
            "channels": 3,
            "conditional": true
        }
    },
    "train": {
        "n_iter": 20,
        "val_freq": 10000,
        "save_checkpoint_freq": 10,
        "print_freq": 1,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": {
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "sr_gopro"
    } 
}